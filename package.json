{
  "name": "tradl-alpha-website",
  "version": "0.1.0",
  "private": true,
  "description": "Tradl AI alpha launch website.",
  "scripts": {
    "dev": "next dev --turbopack --port 4100",
    "build": "next build",
    "start": "next start --port 4100",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run build",
    "ds:tokens": "node scripts/build-tokens.mjs",
    "ds:icons": "node scripts/extract-icons.mjs && node scripts/verify-icons.mjs",
    "ds:brand": "node scripts/build-brand.mjs",
    "ds:build": "npm run ds:tokens && npm run ds:icons && npm run ds:brand",
    "ds:contrast": "node scripts/check-contrast.mjs",
    "ds:verify": "npm run ds:build && git diff --exit-code --stat src/design-system/tokens src/components/ui/icons src/components/ui/brand"
  },
  "dependencies": {
    "next": "^16",
    "react": "^19",
    "react-dom": "^19",
    "three": "^0.182.0",
    "@react-three/fiber": "^9",
    "@react-three/drei": "^10",
    "@react-three/postprocessing": "^3",
    "@react-three/rapier": "^2",
    "postprocessing": "^6",
    "gsap": "^3.13.0",
    "@gsap/react": "^2.1.2",
    "lenis": "^1.3.11",
    "motion": "^12",
    "zustand": "^5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "tailwindcss": "^4",
    "typescript": "^5.9.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.182.0",
    "eslint": "^9",
    "eslint-config-next": "^16"
  }
}
