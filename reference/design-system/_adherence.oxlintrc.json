{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/data/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IBM Plex Sans|Lato))/i]",
        "message": "Font not provided by the design system. Available: IBM Plex Sans, Lato."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:neutral|green|yellow|positive|negative)$/]",
        "message": "<Badge> variant must be one of 'neutral' | 'green' | 'yellow' | 'positive' | 'negative'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|accent|padding|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: level, accent, padding, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:l2|l3|l4)$/]",
        "message": "<Card> level must be one of 'l2' | 'l3' | 'l4'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:column|metric|rule|positive|negative)$/]",
        "message": "<Card> accent must be one of 'column' | 'metric' | 'rule' | 'positive' | 'negative'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:category|children|key|ref|className|style|children)$/]",
        "message": "<CategoryTag> doesn't accept that prop. Declared props: category, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryTag'] > JSXAttribute[name.name='category'] > Literal[value!=/^(?:column|metric|rule)$/]",
        "message": "<CategoryTag> category must be one of 'column' | 'metric' | 'rule'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Delta'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|format|showArrow|key|ref|className|style|children)$/]",
        "message": "<Delta> doesn't accept that prop. Declared props: value, format, showArrow."
      },
      {
        "selector": "JSXOpeningElement[name.name='Delta'] > JSXAttribute[name.name='format'] > Literal[value!=/^(?:percent|number)$/]",
        "message": "<Delta> format must be one of 'percent' | 'number'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|delta|deltaFormat|accent|key|ref|className|style|children)$/]",
        "message": "<StatTile> doesn't accept that prop. Declared props: label, value, delta, deltaFormat, accent."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute[name.name='deltaFormat'] > Literal[value!=/^(?:percent|number)$/]",
        "message": "<StatTile> deltaFormat must be one of 'percent' | 'number'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:column|metric|rule)$/]",
        "message": "<StatTile> accent must be one of 'column' | 'metric' | 'rule'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
